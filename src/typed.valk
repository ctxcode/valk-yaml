use valk.json
use valk.time

@ignore_access

// `value` as `T`; a value that does not fit throws `.type` naming the key at `path`
fn value_to[T](value: json.Value, path: String) T !Error {
    #if T.$is_nullable
    if value.is_null : return null
    return value_to[T.$nonnull](value, path) !>
    #elif T.$is_type_of(time.DateTime)
    let text = value.is_string ? value.string : ""
    return parse_datetime(text) ?! throw .type("'" + path + "' should be a date, or a date and time", 0, 0)
    #elif T.$has_method(from_yaml_value)
    return T.from_yaml_value(value, path) !>
    #elif T.$is_type_of(json.Value) || T.$is_type_of(String) || T.$is_integer || T.$is_float || T.$is_bool || T.$has_method(from_json_value) || T.$has_method(from_json_value_auto) || !T.$is_structural
    return value.to_type[T]() ! throw .type("'" + path + "' should be " + expected_kind[T](), 0, 0)
    #else
    if !value.is_object : throw .type("'" + path + "' should be a mapping", 0, 0)
    let source = value.object
    let result = T {
        #loop properties T as prop
        prop: <{
            #if prop.$tag("yaml") == "-"
            #if prop.$has_default_value
            return prop.$default_value
            #else
            #error "Skipped YAML property has no default value"
            #end
            #else
            let name = prop.$tag("yaml", prop.name)
            let key = path.is_empty() ? name : path + "." + name
            #if prop.$has_explicit_default_value || prop.$type.$is_nullable || (prop.$has_tag("omitempty") && prop.$has_default_value)
            let field = source.get(name) ! return prop.$default_value
            if field.is_null : return prop.$default_value
            return value_to[prop](field, key) !>
            #else
            let field = source.get(name) ! throw .type("'" + key + "' is missing", 0, 0)
            return value_to[prop](field, key) !>
            #end
            #end
        }
        #end
    }
    return result
    #end
}

fn is_empty_value(data: $T) bool {
    #if T.$is_nullable
    if !isset(data) : return true
    return is_empty_value(data)
    #elif T.$is_type_of(json.Value)
    if data.is_null : return true
    if data.is_string : return data.string.bytes == 0
    if data.is_array : return data.array.length == 0
    if data.is_object : return data.object.length == 0
    if data.is_bool : return !data.bool
    if data.is_int : return data.int == 0
    if data.is_float : return data.float == 0.0
    return false
    #elif T.$is_type_of(String)
    return data.bytes == 0
    #elif T.$has_method(is_json_empty)
    return data.is_json_empty()
    #elif T.$is_bool
    return !data
    #elif T.$is_integer
    #if T.$is_signed
    return data.to(int) == 0
    #else
    return data.to(uint) == 0
    #end
    #elif T.$is_float
    return data == 0.0
    #else
    return false
    #end
}

// `data` as a JSON value, as `json.from` makes it, with dates as ISO 8601 text. `stack` holds the
// objects being written, so one that holds itself becomes "(recursion)" as there.
fn value_from(data: $T, stack: Array[uint]) json.Value {
    #if T.$is_nullable
    if !isset(data) : return null
    return value_from(data, stack)
    #elif T.$is_type_of(time.DateTime)
    return json.new_string(data.to_iso8601())
    #elif T.$has_method(to_yaml_value)
    return data.to_yaml_value(stack)
    #elif T.$has_method(to_json_string)
    return json.new_string(data.to_json_string())
    #elif T.$is_type_of(json.Value) || T.$is_type_of(String) || T.$is_integer || T.$is_float || T.$is_bool || T.$has_method(to_json_value) || T.$has_method(to_json_value_with_stack) || !T.$is_structural
    return json.from(data)
    #else
    #if T.$is_pointer
    @unsafe
    let node = data.@cast(ptr).@cast(uint)
    if stack.contains(node) : return json.new_string("(recursion)")
    stack.append(node)
    #end
    let values = Map[json.Value]{}
    #loop object data as prop
    #if prop.$tag("yaml") != "-"
    #if prop.$has_tag("omitempty")
    if !is_empty_value(prop) {
        values.set(prop.$tag("yaml", prop.name), value_from(prop, stack))
    }
    #else
    values.set(prop.$tag("yaml", prop.name), value_from(prop, stack))
    #end
    #end
    #end
    #if T.$is_pointer
    stack.pop_last() _
    #end
    return json.new_object(values)
    #end
}

extend Array[YAML_ITEM] {
    - fn to_yaml_value(stack: Array[uint]) json.Value {
        #if YAML_ITEM.$is_raw_pointer
        @unsafe
        #end
        let result = Array[json.Value]{}
        each this as item {
            result.append(value_from(item, stack))
        }
        return json.new_array(result)
    }

    - static fn from_yaml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_array : throw .type("'" + path + "' should be a sequence", 0, 0)
        let result = SELF.new()
        each value.array as item, index {
            result.append(value_to[YAML_ITEM](item, path + "[" + index + "]") !>)
        }
        return result
    }
}

extend HashMap[YAML_KEY, YAML_VALUE] {
    #if YAML_KEY.$is_type_of(String)
    - fn to_yaml_value(stack: Array[uint]) json.Value {
        let result = Map[json.Value]{}
        each this as item, key {
            result.set(key, value_from(item, stack))
        }
        return json.new_object(result)
    }

    - static fn from_yaml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_object : throw .type("'" + path + "' should be a mapping", 0, 0)
        let result = SELF.new()
        each value.object as item, key {
            let item_path = path.is_empty() ? key : path + "." + key
            result.set(key, value_to[YAML_VALUE](item, item_path) !>)
        }
        return result
    }
    #elif YAML_KEY.$is_integer && !YAML_KEY.$is_enum
    - fn to_yaml_value(stack: Array[uint]) json.Value {
        let result = Map[json.Value]{}
        each this as item, key {
            result.set(key.to_string(), value_from(item, stack))
        }
        return json.new_object(result)
    }

    - static fn from_yaml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_object : throw .type("'" + path + "' should be a mapping", 0, 0)
        let result = SELF.new()
        each value.object as item, key {
            let item_path = path.is_empty() ? key : path + "." + key
            let number = key.to(YAML_KEY) ! throw .type("'" + item_path + "' should have an integer key", 0, 0)
            result.set(number, value_to[YAML_VALUE](item, item_path) !>)
        }
        return result
    }
    #end
}

extend FlatMap[YAML_FLAT_KEY, YAML_FLAT_VALUE] {
    #if YAML_FLAT_KEY.$is_type_of(String)
    - fn to_yaml_value(stack: Array[uint]) json.Value {
        let result = Map[json.Value]{}
        each this as item, key {
            result.set(key, value_from(item, stack))
        }
        return json.new_object(result)
    }

    - static fn from_yaml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_object : throw .type("'" + path + "' should be a mapping", 0, 0)
        let result = SELF.new()
        each value.object as item, key {
            let item_path = path.is_empty() ? key : path + "." + key
            result.set(key, value_to[YAML_FLAT_VALUE](item, item_path) !>)
        }
        return result
    }
    #end
}

extend HashSet[YAML_SET_ITEM] {
    - fn to_yaml_value(stack: Array[uint]) json.Value {
        let result = Array[json.Value]{}
        each this as item {
            result.append(value_from(item, stack))
        }
        return json.new_array(result)
    }

    - static fn from_yaml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_array : throw .type("'" + path + "' should be a sequence", 0, 0)
        let result = SELF.new()
        each value.array as item, index {
            result.add(value_to[YAML_SET_ITEM](item, path + "[" + index + "]") !>)
        }
        return result
    }
}

extend Deque[YAML_DEQUE_ITEM] {
    - fn to_yaml_value(stack: Array[uint]) json.Value {
        let result = Array[json.Value]{}
        each this as item {
            result.append(value_from(item, stack))
        }
        return json.new_array(result)
    }

    - static fn from_yaml_value(value: json.Value, path: String) SELF !Error {
        if !value.is_array : throw .type("'" + path + "' should be a sequence", 0, 0)
        let result = SELF.new()
        each value.array as item, index {
            result.push_back(value_to[YAML_DEQUE_ITEM](item, path + "[" + index + "]") !>)
        }
        return result
    }
}

// A YAML timestamp: a date, or a date and time. One with an offset is converted to UTC, one
// without is taken as UTC, and a date alone is its midnight. Null for anything else.
fn parse_datetime(text: String) ?time.DateTime {
    let n = text.length
    if n < 10 || text[4] != '-' || text[7] != '-' : return null
    let year = read_digits(text, 0, 4) ?! return null
    let month = read_digits(text, 5, 2) ?! return null
    let day = read_digits(text, 8, 2) ?! return null
    if n == 10 : return time.DateTime.new(year.to(int), month, day) !? null
    let i: uint = 10
    if text[i] == 'T' || text[i] == 't' {
        i++
    } else {
        if text[i] != ' ' && text[i] != '\t' : return null
        while text[i] == ' ' || text[i] == '\t' : i++
    }
    // The hour may have one digit
    let hour_digits: uint = is_digit(text[i + 1]) ? 2 : 1
    let hour = read_digits(text, i, hour_digits) ?! return null
    i += hour_digits
    if text[i] != ':' : return null
    let minute = read_digits(text, i + 1, 2) ?! return null
    i += 3
    let second: uint = 0
    let microsecond: uint = 0
    if text[i] == ':' {
        second = read_digits(text, i + 1, 2) ?! return null
        i += 3
        if text[i] == '.' {
            i++
            let digits: uint = 0
            while is_digit(text[i]) {
                // Microseconds keep six digits; more are cut off
                if digits < 6 {
                    microsecond = microsecond * 10 + (text[i] - '0').to(uint)
                    digits++
                }
                i++
            }
            while digits < 6 {
                microsecond = microsecond * 10
                digits++
            }
        }
    }
    while text[i] == ' ' || text[i] == '\t' : i++
    let offset: int = 0
    if text[i] == 'Z' || text[i] == 'z' {
        i++
    } else if text[i] == '+' || text[i] == '-' {
        let sign = text[i]
        i++
        let digits: uint = is_digit(text[i + 1]) ? 2 : 1
        let hours = read_digits(text, i, digits) ?! return null
        i += digits
        let minutes: uint = 0
        if text[i] == ':' {
            minutes = read_digits(text, i + 1, 2) ?! return null
            i += 3
        }
        offset = (hours * 60 + minutes).to(int)
        if sign == '-' : offset = 0 - offset
    }
    if i != n : return null
    let local = time.DateTime.new(year.to(int), month, day, hour, minute, second, microsecond) !? null
    if !isset(local) : return null
    if offset == 0 : return local
    return local.add_minutes(0 - offset) !? null
}

// The number written with exactly `count` digits at `at`
fn read_digits(text: String, at: uint, count: uint) ?uint {
    if at + count > text.length : return null
    let value: uint = 0
    let i: uint = 0
    while i < count {
        let ch = text[at + i]
        if ch < '0' || ch > '9' : return null
        value = value * 10 + (ch - '0').to(uint)
        i++
    }
    return value
}

fn expected_kind[T]() String {
    #if T.$nonnull.$is_type_of(String)
    return "a string"
    #elif T.$is_integer
    return "an integer that fits the field"
    #elif T.$is_float
    return "a number"
    #elif T.$is_bool
    return "true or false"
    #else
    return "a value of the field's type"
    #end
}
